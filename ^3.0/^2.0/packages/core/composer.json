{
    "name": "korozcolt/payments-core",
    "description": "Framework-agnostic core of korozcolt/payments: Wompi, MercadoPago and ePayco drivers for any PHP project.",
    "keywords": ["payments", "payment-gateway", "wompi", "mercadopago", "epayco", "colombia", "psr-18", "framework-agnostic"],
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/korozcolt/payments",
    "require": {
        "php": "^8.2",
        "mercadopago/dx-php": "^3.0",
        "nesbot/carbon": "^2.67|^3.0",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0|^2.0",
        "psr/log": "^1.1|^2.0|^3.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "pestphp/pest": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Korbytes\\Payments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Korbytes\\Payments\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
