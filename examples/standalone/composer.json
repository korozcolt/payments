{
    "name": "korozcolt/payments-standalone-example",
    "description": "Runs korozcolt/payments-core with plain PHP: Guzzle (PSR-18) + SQLite (PDO). No framework.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        { "type": "path", "url": "../../packages/core", "options": { "symlink": true } }
    ],
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "guzzlehttp/guzzle": "^7.5",
        "korozcolt/payments-core": "@dev"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
